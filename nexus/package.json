{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS: local read-only telemetry dashboard for the six-axis lower-body humanoid",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "collector": "tsx server/collector.ts",
    "test:collector": "vitest run server"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serialport": "^13.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  }
}
